<div class="col">
  {% assign project_link = project.redirect | default: project.url %}
  <article class="card hoverable project-card">
    <a class="project-card-main" href="{{ project_link | relative_url }}">
      {% if project.img %}
        {% assign project_alt = project.img_alt | default: project.title %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "(min-width: 768px) 450px, 100vw"
          alt=project_alt
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </a>
    <div class="project-card-extra">
      <div class="project-links">
        <a href="{{ project_link | relative_url }}">Project page <span aria-hidden="true">↗</span></a>
        {% if project.github %}
          <div class="github-icon">
            <a href="{{ project.github }}" aria-label="Code repository for {{ project.title | escape }}">
              <i class="fa-brands fa-github" aria-hidden="true"></i> Code
            </a>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
      {% if project.overview %}
        <details class="project-overview">
          <summary>Overview<span class="sr-only">: {{ project.title }}</span></summary>
          <p>{{ project.overview | escape }}</p>
        </details>
      {% endif %}
    </div>
  </article>
</div>
