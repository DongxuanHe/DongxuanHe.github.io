{% assign repo_url = include.repository | split: '/' %}

<div class="repo p-3 m-2 border rounded" style="width: 320px;">
  <a href="https://github.com/{{ include.repository }}" style="text-decoration: none;">
    <h5 style="margin-bottom: 6px;">
      {{ repo_url[1] }}
    </h5>
  </a>

  <p style="margin: 0; font-size: 0.9rem; color: #666;">
    {{ repo_url[0] }}/{{ repo_url[1] }}
  </p>
</div>
