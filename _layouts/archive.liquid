---
layout: default
---
<div class="post">
  {% assign archive_series = site.data.seminar_series[page.title] %}
  {% assign event_series = site.data.event_series[page.title] %}
  {% if page.type == 'categories' and archive_series %}
    {% include blog_breadcrumbs.liquid seminar=true %}
  {% elsif page.type == 'categories' and event_series %}
    {% include blog_breadcrumbs.liquid event=true %}
  {% elsif page.type == 'tags' and page.title == 'event' %}
    {% include blog_breadcrumbs.liquid event=true %}
  {% elsif page.type == 'tags' and page.title == 'seminar' %}
    {% include blog_breadcrumbs.liquid seminar=true %}
  {% else %}
    {% include blog_breadcrumbs.liquid %}
  {% endif %}
  <header class="post-header">
    {% if page.type == 'categories' %}
      {% assign series = archive_series | default: event_series %}
      <h1 class="post-title"><i class="fa-solid fa-tag fa-sm"></i> {{ series.label | default: page.title }}</h1>
      <p class="post-description">
        {% if series.description %}{{ series.description }}{% else %}an archive of {{ page.collection_name }} in this category{% endif %}
      </p>
    {% elsif page.type == 'year' %}
      <h1 class="post-title"><i class="fa-solid fa-calendar fa-sm"></i> {{ page.date | date: '%Y' }}</h1>
      <p class="post-description">an archive of {{ page.collection_name }} from this year</p>
    {% elsif page.type == 'tags' %}
      <h1 class="post-title"><i class="fa-solid fa-hashtag fa-sm"></i> {{ page.title }}</h1>
      <p class="post-description">an archive of {{ page.collection_name }} with this tag</p>
    {% endif %}
  </header>

  <article class="archive">
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% if page.seminar_series %}
          {% assign archive_documents = site.posts | where_exp: 'post', "post.tags contains 'seminar'" %}
          {% assign archive_documents = archive_documents | where_exp: 'post', 'post.categories contains page.seminar_series' %}
        {% else %}
          {% assign archive_documents = page.documents %}
        {% endif %}
        {% for document in archive_documents %}
          <tr>
            <th scope="row">{{ document.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if document.redirect == blank %}
                <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
              {% elsif document.redirect contains '://' %}
                <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
              {% else %}
                <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </article>
</div>
